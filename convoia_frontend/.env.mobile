# API base URL for native (Capacitor) builds — used by `vite build --mode mobile`
# (npm run cap:android / cap:ios / mobile:build).
#
# Without this file, --mode mobile falls through to .env.local
# (http://localhost:5000/api), which makes the installed app point at the phone
# itself and unable to reach the backend on a real device.
VITE_API_URL=https://convoia.ai/api
